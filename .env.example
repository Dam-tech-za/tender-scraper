# Copy to .env for local runs. Never commit .env.
TENDER_SCOUT_LOG_LEVEL=INFO

# Email via Resend (https://resend.com, free tier) ...
RESEND_API_KEY=
# ... or via SMTP (Microsoft 365: smtp.office365.com / 587, needs SMTP AUTH enabled for the mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=
EMAIL_TO=
DASHBOARD_URL=
